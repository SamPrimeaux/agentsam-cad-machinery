{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "agentsam-cad-creator",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "cad.inneranimalmedia.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inneranimalmedia-business",
      "database_id": "cf87b717-d4e2-4cf8-bab0-a81268e32d49"
    }
  ],
  "r2_buckets": [
    {
      "binding": "WEBSITE_ASSETS",
      "bucket_name": "cad"
    }
  ],
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*",
      "!/assets/*.js",
      "!/assets/*.css",
      "!/assets/*.png",
      "!/assets/*.jpg",
      "!/assets/*.svg",
      "!/assets/*.woff2",
      "!/assets/work/*",
      "!/brand/*",
      "!/primetech/*",
      "!/editorial-assets/*",
      "!/about-app/*",
      "!/cms-content/*",
      "!/companions/*",
      "!/scenes/*.json",
      "!/scenes/*.js",
      "!/home-app/*",
      "!/samscene/assets/*.js",
      "!/samscene/assets/*.css",
      "!/samscene/assets/*.png",
      "!/samscene/brand/*",
      "!/samscene/api-data/*",
      "!/fonts/*",
      "!/studio/assets/*"
    ]
  }
}
